SEB_PORT=43126
SEB_HOST=127.0.0.1
SEB_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5177

# The 64-character Config Key generated for the approved .seb configuration.
SEB_CONFIG_KEY=replace-with-the-approved-64-character-config-key

# Optional comma-separated Browser Exam Keys. Enable the requirement only
# after the approved SEB build(s) and keys are known.
SEB_BROWSER_EXAM_KEYS=
SEB_REQUIRE_BROWSER_EXAM_KEY=false

# Use a random value of at least 32 characters. Never expose this to React.
SEB_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SEB_SESSION_TTL_SECONDS=300

# Local POC only. Keep false in staging and production.
SEB_ALLOW_SIMULATION=false
